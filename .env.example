# ============================================================================
# ALTERYX METRICS SYSTEM - CONFIGURATION
# ============================================================================
#
# Copy this file to .env and update values for your Alteryx account
# DO NOT commit .env to git (it's in .gitignore)
#

# ============================================================================
# SNOWFLAKE CONNECTION (REQUIRED)
# ============================================================================

# Account identifier - SSO connection
# Get from: https://login.snowflakecomputing.com (check account URL)
SNOWFLAKE_ACCOUNT=ALTERYX-ALTERYX_EDW

# Email address for SSO authentication
# This will be used to log in via your company SSO
SNOWFLAKE_USER=your_email@alteryx.com

# Warehouse name for queries (compute resources)
# Default: COMPUTE_WH
# Ask IT if unsure
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Database containing metrics
# Default: DISCOVERY_PRODUCT_MANAGEMENT (do not change)
SNOWFLAKE_DATABASE=DISCOVERY_PRODUCT_MANAGEMENT

# Schema containing metric views
# Default: METRIC_STORE (do not change)
SNOWFLAKE_SCHEMA=METRIC_STORE

# ============================================================================
# USER SETTINGS (REQUIRED)
# ============================================================================

# Your email address for audit logging
# Used to track who accessed which metrics and when
USER=your_email@alteryx.com

# ============================================================================
# AUTHENTICATION (OPTIONAL)
# ============================================================================

# By default, SSO (externalbrowser) is used for authentication.
# This opens a browser window for you to log in via SSO.
# NO PASSWORDS stored locally - all authentication via your company SSO.

# Optional: Snowflake role (usually not needed unless directed by IT)
# If specified, this role will be used instead of your default role
# SNOWFLAKE_ROLE=DHIRAJ_SAHU_ROLE

# ============================================================================
# ADVANCED OPTIONS (OPTIONAL)
# ============================================================================

# Enable debug logging (verbose output)
# DEBUG=true

# Connection timeout in seconds (default: 60)
# SNOWFLAKE_TIMEOUT=60

# Query timeout in seconds (default: 600)
# SNOWFLAKE_QUERY_TIMEOUT=600

# Cache results in memory (default: true)
# ENABLE_CACHE=true

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Edit this file and replace placeholder values:
#    - your_email@alteryx.com → your actual Alteryx email
#
# 2. Save as .env in the repo root directory
#
# 3. Test connection:
#    python -m cli.main products
#
# 4. On first run, a browser window will open for SSO login
#    → Authenticate with your Alteryx credentials
#    → Return to terminal once logged in
#
# Questions? Contact: insights@alteryx.com
# ============================================================================
